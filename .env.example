# Copy to .env before docker compose up.
POSTGRES_DB=solana_s1
POSTGRES_USER=solana_s1
POSTGRES_PASSWORD=local_development_only_replace_me
DATABASE_URL=postgresql://solana_s1:local_development_only_replace_me@db:5432/solana_s1
PORT=8787
BIND_ADDRESS=0.0.0.0
# GeckoTerminal public API: approximately 10 calls/min. 2 pages/30s = ~4/min.
GECKO_API_BASE=https://api.geckoterminal.com/api/v2
POLL_INTERVAL_MS=30000
PAGES_PER_POLL=2
# Refresh up to 20 older/disappeared pools each cycle using one extra request.
WATCHLIST_SIZE=20
FETCH_TIMEOUT_MS=10000
# Fails closed for broken inputs; set to 0 only to disable collection.
COLLECTOR_ENABLED=1

# S4.1 — Codex only (host CLI, ChatGPT login). No paid API fallback.
# These defaults must not initiate an AI call.
S4_AI_BACKEND=codex
S4_DRY_RUN=1
S4_CODEX_ENABLED=0
S4_PAID_API_FALLBACK=0
S4_LIVE_TRADING_ENABLED=0
S4_TIMEOUT_MS=120000
