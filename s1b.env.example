# APPEND to existing .env. Do NOT overwrite working S1a database configuration.
# Use a trusted mainnet RPC vendor with BOTH HTTPS and WSS endpoints.
# Keep API keys out of Git. An RPC provider may impose paid quotas.
SOLANA_RPC_HTTP_URL=https://YOUR_SOLANA_RPC_PROVIDER_ENDPOINT
SOLANA_RPC_WS_URL=wss://YOUR_SOLANA_WS_PROVIDER_ENDPOINT
S1B_MAX_POOLS=3
S1B_POOL_MAX_AGE_MINUTES=30
S1B_SESSION_SECONDS=300
S1B_RECONNECT_MS=10000
S1B_BACKFILL_LIMIT=30
S1B_RPC_SPACING_MS=1000
S1B_TX_BATCH_SIZE=10
S1B_TX_MAX_ATTEMPTS=8
S1B_MAX_NOTIFICATION_QUEUE=500
